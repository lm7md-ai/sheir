        {"name": "poem_uid", "type": "TEXT", "nullable": false},
        {"name": "stability", "type": "REAL", "nullable": false, "defaultValue": 1.0},
        {"name": "difficulty", "type": "REAL", "nullable": false, "defaultValue": 5.0},
        {"name": "repetitions", "type": "INTEGER", "nullable": false, "defaultValue": 0},
        {"name": "interval_days", "type": "INTEGER", "nullable": false, "defaultValue": 0},
        {"name": "last_reviewed", "type": "TEXT", "nullable": false},
        {"name": "next_due", "type": "TEXT", "nullable": false}
